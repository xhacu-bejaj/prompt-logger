{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {  
        "json_file": {
            "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
            "fmt": "%(asctime)s %(levelname)s %(name)s %(message)s %(provider)s %(prompt)s %(response)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "json_file",
            "stream": "ext://sys.stderr",
            "level": "INFO"
        },
        "file_handler": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "json_file",
            "filename": "history.log",
            "maxBytes": 10485760,  
            "backupCount": 5,      
            "level": "INFO",
            "encoding": "utf-8"
        }
    },
    "loggers": {
        "uvicorn.error": {
            "handlers": ["console", "file_handler"],
            "level": "ERROR",
            "propagate": false
        },
        "uvicorn.access": {
            "handlers": ["file_handler"],
            "level": "INFO",
            "propagate": false
        },
        "": {
            "handlers": ["console", "file_handler"],
            "level": "INFO"
        }
    },
    "root": {
        "level": "INFO",
        "handlers": ["console"]
    }
}